{
  "name": "@boltronx/react-ui",
  "version": "0.1.0",
  "description": "Simple, themeable React components that work with plain HTML forms, Server Components and SSR.",
  "license": "MIT",
  "author": "Gabriel Jefferson Boltron <gabrielboltron@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boltronx/ui-components.git",
    "directory": "packages/react-ui"
  },
  "homepage": "https://boltronx.github.io/ui-components/react/",
  "bugs": {
    "url": "https://github.com/boltronx/ui-components/issues"
  },
  "keywords": [
    "react",
    "nextjs",
    "server-components",
    "ssr",
    "components",
    "ui",
    "forms"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./styles.css": "./dist/styles.css",
    "./components.css": "./dist/components.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "vite": [
        "./dist/vite.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node scripts/build-js.mjs && tsup && node scripts/build-css.mjs",
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:js": "node scripts/build-js.mjs --watch",
    "dev:css": "node scripts/build-css.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css components.css",
    "prepack": "node scripts/copy-meta.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "lightningcss": "^1.33.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
